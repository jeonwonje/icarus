# Copy to .env and fill in. Never commit .env.

# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (DM @userinfobot to get it)
TELEGRAM_OWNER_ID=

# From `claude setup-token` (Claude subscription OAuth). Re-mint when the canary complains.
CLAUDE_CODE_OAUTH_TOKEN=

# Alias (sonnet|opus|haiku) or a full model id. /model switches at runtime.
ICARUS_MODEL=sonnet

# Optional IANA timezone for schedules (defaults to system timezone)
ICARUS_TZ=

# --- MCP servers (Desktop .mcp.json, not .env) ---
# Copy docs/mcp.json.example → Desktop\.mcp.json
# Required keys: mcpServers.calendar, mcpServers.browser (both stdio)
# Calendar auth is one-time, outside Claude: npx @cocal/google-calendar-mcp auth
# (Desktop-app OAuth client JSON → state\gcp-oauth.keys.json; see src/modules/calendar/README.md)

# --- Required module env (boot fails if missing) ---

# Required: Canvas LMS (school host + personal access token from Canvas Account → Settings → New Access Token)
CANVAS_BASE_URL=
CANVAS_API_TOKEN=

# Required: folder where daily Outlook .pst exports land
ICARUS_MAIL_DROP=

# Required: personal-Telegram userbot (my.telegram.org → API development tools; then: npm run tg-setup)
TG_API_ID=
TG_API_HASH=
TG_SESSION=
